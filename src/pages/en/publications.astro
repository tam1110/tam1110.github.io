<Layout title="Publications">
  <h1>Publications</h1>

  <h2>Journal Articles</h2>
  <ol class="pub-list">
    {journals.map((p) => <PublicationItem {...p} />)}
  </ol>

  <h2>International Conferences / Workshops</h2>
  <ol class="pub-list">
    {international.map((p) => <PublicationItem {...p} />)}
  </ol>

  <h2>Domestic Conferences &amp; Others</h2>
  <ol class="pub-list">
    {domestic.map((p) => <PublicationItem {...p} />)}
  </ol>
</Layout>

<style>
  .pub-list {
    counter-reset: pub;
    list-style: none;
    padding: 0;
    margin-top: var(--space-4);
  }
  .pub-list :global(.pub) {
    counter-increment: pub;
    position: relative;
    padding-left: 2.2rem;
  }
  .pub-list :global(.pub)::before {
    content: counter(pub) ".";
    position: absolute;
    left: 0;
    top: 0;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }
</style>
