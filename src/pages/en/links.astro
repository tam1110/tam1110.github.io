---
import Layout from "../../components/Layout.astro";

const links = [
  {
    label: "Kawaguchi Lab (UCLab), Nagoya University — member page",
    href: "https://www.ucl.nuee.nagoya-u.ac.jp/member/",
    note: "Affiliated lab",
  },
  { label: "Ornis Inc.", href: "https://ornis-c.co.jp/", note: "Director" },
  { label: "researchmap", href: "https://researchmap.jp/tamura_naoki" },
  { label: "Google Scholar", href: "https://scholar.google.co.jp/citations?user=tiixNxAAAAAJ&hl=ja" },
  { label: "ORCID", href: "https://orcid.org/0000-0002-3362-697X" },
  { label: "DBLP", href: "https://dblp.uni-trier.de/pid/39/3069.html" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/naoki-tamura-33199029b/" },
  { label: "GitHub", href: "https://github.com/tam1110" },
];
---

<Layout title="Links">
  <h1>Links</h1>

  <ul class="links">
    {
      links.map((link) => (
        <li>
          {link.href ? (
            <a href={link.href} rel="noopener" target="_blank">
              {link.label}
            </a>
          ) : (
            <span>{link.label}</span>
          )}
          {link.note && <span class="links__note muted"> — {link.note}</span>}
        </li>
      ))
    }
  </ul>
</Layout>

<style>
  .links {
    list-style: none;
    padding: 0;
    margin-top: var(--space-6);
  }
  .links li {
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-border);
  }
  .links__note {
    font-size: 0.9rem;
  }
</style>
