---
import Layout from "../../components/Layout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import PublicationItem from "../../components/PublicationItem.astro";

const interests = [
  "Urban Computing",
  "Human Mobility Modeling",
  "Location-based Data Analysis",
  "Spatio-temporal Data Mining",
  "Representation Learning",
];

// Paper / presentation awards
const awards = [
  { date: "May 2023", text: "IPSJ 107th MBL Research Meeting — Outstanding Presentation Award" },
  { date: "Jul 2021", text: "DICOMO2021 — Best Paper Award & Outstanding Presentation Award" },
];

// Invited talks
const invitedTalks = [
  {
    title: "Embedding Vectorization of Geospatial Information Based on Mobility Big Data",
    venue: "10th Geography & Language Workshop",
    location: "Online",
    date: "Nov 27, 2024",
    links: [
      {
        label: "Slides",
        href: "https://speakerdeck.com/tam1110/yi-dong-bitugudetaniji-dukudi-li-qing-bao-nomai-meip-mibekutoruhua",
      },
      { label: "Event page", href: "https://sites.google.com/view/geography-and-language/studygroup" },
    ],
  },
];

// Competitions
const competitions = [
  { date: "Nov 2025", text: "ACM SIGSPATIAL GIS Cup 2025 — 3rd Prize" },
  { date: "Oct 2024", text: "Human Mobility Prediction Challenge 2024 — 1st Prize (GEOBLEU)" },
  { date: "Nov 2023", text: "Human Mobility Prediction Challenge 2023 — 1st Prize" },
];

const selectedPubs = [
  {
    authors:
      "Naoki Tamura, Nodira Tillayeva, Haru Terashima, Kazuyuki Shoji, Shin Katayama, Kenta Urano, Takuro Yonezawa, Nobuo Kawaguchi",
    title: "Additive Compositionality in Urban Area Embeddings Based on Human Mobility Patterns.",
    venue: "ACM Transactions on Spatial Algorithms and Systems, 12(3), Article 17, 2026.",
    doi: "https://doi.org/10.1145/3804448",
  },
  {
    authors:
      "Naoki Tamura, Kazuyuki Shoji, Shin Katayama, Kenta Urano, Takuro Yonezawa, Nobuo Kawaguchi",
    title:
      "OpenUAS: Embeddings of Cities in Japan with Anchor Data for Cross-city Analysis of Area Usage Patterns.",
    venue: "CoRR, abs/2407.19872, 2024.",
    doi: "https://doi.org/10.48550/arXiv.2407.19872",
  },
  {
    authors: "Naoki Tamura, Kenta Urano, Shunsuke Aoki, Takuro Yonezawa, Nobuo Kawaguchi",
    title:
      "Synthetic People Flow: Privacy-Preserving Mobility Modeling from Large-Scale Location Data in Urban Areas.",
    venue: "MobiQuitous 2021, pp. 553–567, 2022.",
    doi: "https://doi.org/10.1007/978-3-030-94822-1_36",
  },
];

const projects = [
  {
    title: "OpenUAS",
    description:
      "An open dataset of anchored area embeddings that represent how urban areas are used, based on human mobility data.",
    href: "/en/projects/openuas",
    tags: ["Open Dataset", "Area Embedding", "Human Mobility"],
  },
  {
    title: "LocationBind",
    description: "Representation learning that aligns location and diverse modalities in a shared latent space.",
    href: "/en/projects/locationbind",
    tags: ["Area Embedding", "Multimodal Alignment", "Representation Learning"],
  },
  {
    title: "Synthetic People Flow Generation",
    description:
      "Generating city-scale, privacy-preserving synthetic people-flow data from large-scale mobility logs.",
    href: "/en/projects/synthetic-people-flow",
    tags: ["Human Mobility", "Privacy", "Simulation"],
  },
  {
    title: "Additive Compositionality of Area Embeddings",
    description:
      "Analyzing how addition/averaging of mobility-based area embeddings corresponds to spatial composition.",
    href: "/en/projects/area-embedding-additivity",
    tags: ["Area Embedding", "Representation Learning", "Human Mobility"],
  },
];
---

<Layout title="Home">
  <!-- Hero -->
  <section class="hero">
    <h1 class="hero__name">
      Naoki Tamura
      <span class="hero__name-en">田村 直樹</span>
    </h1>
    <p class="hero__affil">
      <a href="https://www.ucl.nuee.nagoya-u.ac.jp/" rel="noopener" target="_blank">Ph.D. Student, Kawaguchi Lab (UCLab), Nagoya University</a>
      {" / "}
      <a href="https://ornis-c.co.jp/" rel="noopener" target="_blank">Co-founder &amp; Director, Ornis Inc.</a>
    </p>

    <ul class="hero__links">
      <li><a href="https://researchmap.jp/tamura_naoki" rel="noopener" target="_blank">researchmap</a></li>
      <li><a href="https://scholar.google.co.jp/citations?user=tiixNxAAAAAJ&hl=ja" rel="noopener" target="_blank">Google Scholar</a></li>
      <li><a href="https://www.linkedin.com/in/naoki-tamura-33199029b/" rel="noopener" target="_blank">LinkedIn</a></li>
      <li><a href="https://github.com/tam1110" rel="noopener" target="_blank">GitHub</a></li>
    </ul>

    <div class="button-row">
      <a class="button" href="/en/about">About / CV</a>
      <a class="button" href="/en/publications">Publications</a>
      <a class="button" href="/en/awards">Awards</a>
      <a class="button" href="/en/projects">Projects</a>
    </div>

    <h2 class="section-label">Research Interests</h2>
    <ul class="tags">
      {interests.map((i) => <li>{i}</li>)}
    </ul>
  </section>

  <!-- Publications -->
  <section>
    <h2>Publications</h2>
    <ol class="pub-list">
      {selectedPubs.map((p) => <PublicationItem {...p} />)}
    </ol>
    <p><a href="/en/publications">View all publications →</a></p>
  </section>

  <!-- Grants -->
  <section>
    <h2>Grants</h2>
    <p class="grant">
      <span class="grant__date muted">Oct 2024 – Mar 2027</span>
      JST ACT-X, Research Area “Cyber-Physical Infrastructure for an AI-Symbiotic Society” — “Integrated Utilization of Multimodal Urban Data via a Shared Latent Space” (Principal Investigator)
    </p>
  </section>

  <!-- Awards -->
  <section>
    <h2>Awards</h2>
    <ul class="award-brief">
      {
        awards.map((a) => (
          <li>
            <span class="award-brief__date muted">{a.date}</span>
            <span>{a.text}</span>
          </li>
        ))
      }
    </ul>
    <p><a href="/en/awards">View all awards →</a></p>
  </section>

  <!-- Invited Talks -->
  <section>
    <h2>Invited Talks</h2>
    <ul class="talk-list">
      {
        invitedTalks.map((t) => (
          <li class="talk">
            <p class="talk__title">{t.title}</p>
            <p class="talk__meta muted">
              {t.venue}, {t.location}, {t.date}
            </p>
            <p class="talk__links">
              {t.links.map((l) => (
                <a href={l.href} rel="noopener" target="_blank">
                  {l.label}
                </a>
              ))}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Competitions -->
  <section>
    <h2>Competitions</h2>
    <ul class="award-brief">
      {
        competitions.map((a) => (
          <li>
            <span class="award-brief__date muted">{a.date}</span>
            <span>{a.text}</span>
          </li>
        ))
      }
    </ul>
    <p><a href="/en/awards">View all awards →</a></p>
  </section>

  <!-- Projects -->
  <section>
    <h2>Projects</h2>
    <div class="card-grid">
      {projects.map((p) => <ProjectCard {...p} />)}
    </div>
  </section>

  <!-- Contact -->
  <section>
    <h2>Contact</h2>
    <p>tam[at]ucl.nuee.nagoya-u.ac.jp <span class="muted">(Nagoya University)</span></p>
    <p>tamura.naoki[at]ornis-c.co.jp <span class="muted">(Ornis Inc.)</span></p>
    <p class="muted">* Replace [at] with @.</p>
  </section>
</Layout>

<style>
  .hero {
    padding: var(--space-8) 0 var(--space-4);
  }
  .hero__name {
    font-family: var(--font-serif);
    font-size: 2.4rem;
    margin: 0 0 var(--space-4);
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .hero__name-en {
    font-size: 1.2rem;
    font-weight: 400;
    color: var(--color-text-muted);
  }
  .hero__affil {
    margin: 0 0 var(--space-4);
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }
  .hero__links {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-6);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    font-size: 0.9rem;
  }
  .hero__links li {
    margin: 0;
  }
  .section-label {
    font-size: 1.1rem;
    margin: var(--space-8) 0 var(--space-2);
  }

  .award-brief {
    list-style: none;
    padding: 0;
    margin: var(--space-4) 0 0;
  }
  .award-brief li {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--color-border);
  }
  .award-brief__date {
    flex: 0 0 5.5rem;
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  .grant {
    margin-top: var(--space-4);
  }
  .grant__date {
    display: block;
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
    margin-bottom: var(--space-1);
  }

  .talk-list {
    list-style: none;
    padding: 0;
    margin: var(--space-4) 0 0;
  }
  .talk {
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-border);
  }
  .talk__title {
    margin: 0;
    font-weight: 600;
  }
  .talk__meta {
    margin: var(--space-1) 0 0;
    font-size: 0.9rem;
  }
  .talk__links {
    margin: var(--space-2) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-size: 0.85rem;
  }

  .pub-list {
    counter-reset: pub;
    list-style: none;
    padding: 0;
    margin-top: var(--space-4);
  }
  .pub-list :global(.pub) {
    counter-increment: pub;
    position: relative;
    padding-left: 2.2rem;
  }
  .pub-list :global(.pub)::before {
    content: counter(pub) ".";
    position: absolute;
    left: 0;
    top: 0;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-4);
  }
  @media (max-width: 640px) {
    .hero__name {
      font-size: 1.9rem;
    }
  }
</style>
